# Local development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (PostgreSQL) — run `npm run db:use:postgres` before `prisma migrate deploy`
# DATABASE_URL="postgresql://user:password@host:5432/meetup?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Required for account verification/recovery on a public deployment.
# SMTP connections require STARTTLS, or use smtps:// for implicit TLS.
EMAIL_SERVER=""
EMAIL_FROM=""

# Persistent, private directory. Back up alongside the database.
UPLOAD_DIRECTORY="./storage/uploads"
